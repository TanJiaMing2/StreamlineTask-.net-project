@model IEnumerable<StreamlineTask.Models.to_do_list>

@{
    ViewData["Title"] = "Index";
}
<link rel="stylesheet" href="~/css/site.css" />
<link rel="stylesheet" href="~/css/test.css" />
<h1 style="color: #E7DFDD;">StreamlineTask</h1>

<form>

    <table class="table1">

        <thead>

            <tr>
                <th>
                    <a>Add a new task</a> <img src="~/css/1709008268109.png" width="20" ; height="20;">
                </th>
                <th></th>
                <th></th>
                <th>
                    <a class="button-50" asp-area="" asp-controller="to_do_list" asp-action="Create">Add task</a>
                </th>
            </tr>

        <th style="color: #E7DFDD;">
            <a></a> @Html.DisplayNameFor(model => model.Date) 
        </th>

        <th>
                @Html.DisplayNameFor(model => model.Task)
        </th>
        <th>
                @Html.DisplayNameFor(model => model.Duration)
        </th>
        <th></th>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        <input type="checkbox" class="tickbox" name="tickbox" value="Checked"> @Html.DisplayFor(modelItem => item.Date)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Task)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Duration) minutes
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.id"><img src="~/css/view.png" class="icon" alt="View" /></a> |
                        <a asp-action="Edit" asp-route-id="@item.id"><img src="~/css/edit.png" class="icon2" alt="Edit" /></a> |
                        <a asp-action="Delete" asp-route-id="@item.id"><img src="~/css/delete.png" class="icon2" alt="Delete" /></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</form>

<br>
<!-- Show total: -->
<p style="color: #E7DFDD;">
    <strong>Total: @Model.Count()</strong>
</p>

<p id="checkedCount" style="color: #E7DFDD;">
    Checked: 0
</p>

<script>
    var checkboxes = document.querySelectorAll('.tickbox');
    checkboxes.forEach(function (checkbox) {
        checkbox.addEventListener('change', updateCheckedCount);
    });

    function updateCheckedCount() {
        var checkedCheckboxes = document.querySelectorAll('.tickbox:checked');
        document.getElementById('checkedCount').innerHTML = 'Checked: ' + checkedCheckboxes.length;
    }
</script>
