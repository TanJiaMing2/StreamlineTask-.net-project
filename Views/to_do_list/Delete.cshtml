@model StreamlineTask.Models.to_do_list

@{
    ViewData["Title"] = "Delete";
}

<link rel="stylesheet" href="~/css/button2.css" />

<h3 align="center">Are you sure you want to delete the task?</h3>
<div>
    <hr />
    <dl class="row">
        <div class="detail-row" align="center">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Task)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Task)
            </dd>
        </div>


        <div class="detail-row" align="center">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Description)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Description)
            </dd>
        </div>

        <div class="detail-row" align="center">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Date)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Date)
            </dd>
        </div>

        <div class="detail-row" align="center">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Duration)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Duration)
            </dd>
        </div>
    </dl>
    <form asp-action="Delete" align="center">
        <input type="hidden" asp-for="id" />
        <a asp-action="Index" class="btn btn-primary adjust">Back to List</a> |
        <input type="submit" value="Delete" class="btn btn-danger adjust" />

    </form>
</div>
